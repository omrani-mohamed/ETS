GtkWidget*
create_Statistique2 (void)
{
  GtkWidget *Statistique2;
  GtkWidget *fixed9;
  GtkWidget *Stat2_Ret;
  GtkWidget *alignment20;
  GtkWidget *hbox20;
  GtkWidget *image20;
  GtkWidget *label63;
  GtkWidget *scrolledwindow1;
  GtkWidget *eventbox96;
  GtkWidget *treeview1;
  GtkWidget *image39;

  Statistique2 = gtk_window_new (GTK_WINDOW_TOPLEVEL);
  gtk_widget_set_size_request (Statistique2, 1125, 660);
  gtk_window_set_title (GTK_WINDOW (Statistique2), _("Type Du Sang Le Plus Rare"));
  gtk_window_set_default_size (GTK_WINDOW (Statistique2), 1125, 660);

  fixed9 = gtk_fixed_new ();
  gtk_widget_show (fixed9);
  gtk_container_add (GTK_CONTAINER (Statistique2), fixed9);
  gtk_widget_set_size_request (fixed9, 1125, 660);

  Stat2_Ret = gtk_button_new ();
  gtk_widget_show (Stat2_Ret);
  gtk_fixed_put (GTK_FIXED (fixed9), Stat2_Ret, 32, 600);
  gtk_widget_set_size_request (Stat2_Ret, 120, 40);

  alignment20 = gtk_alignment_new (0.5, 0.5, 0, 0);
  gtk_widget_show (alignment20);
  gtk_container_add (GTK_CONTAINER (Stat2_Ret), alignment20);

