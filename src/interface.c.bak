GtkWidget*
create_Donneur_Affichage (void)
{
  GtkWidget *Donneur_Affichage;
  GtkWidget *fixed20;
  GtkWidget *label141;
  GtkWidget *scrolledwindow2;
  GtkWidget *treeview_Donneurs;
  GtkWidget *Donneur_Affichage_ret;
  GtkWidget *alignment129;
  GtkWidget *hbox49;
  GtkWidget *image64;
  GtkWidget *label142;

  Donneur_Affichage = gtk_window_new (GTK_WINDOW_TOPLEVEL);
  gtk_window_set_title (GTK_WINDOW (Donneur_Affichage), _("Affichage"));

  fixed20 = gtk_fixed_new ();
  gtk_widget_show (fixed20);
  gtk_container_add (GTK_CONTAINER (Donneur_Affichage), fixed20);
  gtk_widget_set_size_request (fixed20, 1125, 660);

  label141 = gtk_label_new (_("<u><span color=\"black\"  font-weight=\"bold\">La Liste Des Donneurs</span></u>"));
  gtk_widget_show (label141);
  gtk_fixed_put (GTK_FIXED (fixed20), label141, 16, 24);
  gtk_widget_set_size_request (label141, 180, 40);
  gtk_label_set_use_markup (GTK_LABEL (label141), TRUE);

  scrolledwindow2 = gtk_scrolled_window_new (NULL, NULL);
  gtk_widget_show (scrolledwindow2);
  gtk_fixed_put (GTK_FIXED (fixed20), scrolledwindow2, 32, 64);
  gtk_widget_set_size_request (scrolledwindow2, 1096, 456);

  treeview_Donneurs = gtk_tree_view_new ();
  gtk_widget_show (treeview_Donneurs);
  gtk_container_add (GTK_CONTAINER (scrolledwindow2), treeview_Donneurs);
  gtk_widget_set_size_request (treeview_Donneurs, 1096, 456);

  Donneur_Affichage_ret = gtk_button_new ();
  gtk_widget_show (Donneur_Affichage_ret);
  gtk_fixed_put (GTK_FIXED (fixed20), Donneur_Affichage_ret, 32, 592);
  gtk_widget_set_size_request (Donneur_Affichage_ret, 135, 40);

  alignment129 = gtk_alignment_new (0.5, 0.5, 0, 0);
  gtk_widget_show (alignment129);
  gtk_container_add (GTK_CONTAINER (Donneur_Affichage_ret), alignment129);

  hbox49 = gtk_hbox_new (FALSE, 2);
  gtk_widget_show (hbox49);
  gtk_container_add (GTK_CONTAINER (alignment129), hbox49);

  image64 = gtk_image_new_from_stock ("gtk-go-back", GTK_ICON_SIZE_BUTTON);
  gtk_widget_show (image64);
  gtk_box_pack_start (GTK_BOX (hbox49), image64, FALSE, FALSE, 0);

  label142 = gtk_label_new_with_mnemonic (_("<span color=\"black\"  font-weight=\"bold\">Retour</span>"));
  gtk_widget_show (label142);
  gtk_box_pack_start (GTK_BOX (hbox49), label142, FALSE, FALSE, 0);
  gtk_widget_set_size_request (label142, 75, 30);
  gtk_label_set_use_markup (GTK_LABEL (label142), TRUE);

  g_signal_connect ((gpointer) Donneur_Affichage_ret, "clicked",
                    G_CALLBACK (on_Donneur_Affichage_ret_clicked),
                    NULL);

  /* Store pointers to all widgets, for use by lookup_widget(). */
  GLADE_HOOKUP_OBJECT_NO_REF (Donneur_Affichage, Donneur_Affichage, "Donneur_Affichage");
  GLADE_HOOKUP_OBJECT (Donneur_Affichage, fixed20, "fixed20");
  GLADE_HOOKUP_OBJECT (Donneur_Affichage, label141, "label141");
  GLADE_HOOKUP_OBJECT (Donneur_Affichage, scrolledwindow2, "scrolledwindow2");
  GLADE_HOOKUP_OBJECT (Donneur_Affichage, treeview_Donneurs, "treeview_Donneurs");
  GLADE_HOOKUP_OBJECT (Donneur_Affichage, Donneur_Affichage_ret, "Donneur_Affichage_ret");
  GLADE_HOOKUP_OBJECT (Donneur_Affichage, alignment129, "alignment129");
  GLADE_HOOKUP_OBJECT (Donneur_Affichage, hbox49, "hbox49");
  GLADE_HOOKUP_OBJECT (Donneur_Affichage, image64, "image64");
  GLADE_HOOKUP_OBJECT (Donneur_Affichage, label142, "label142");

  return Donneur_Affichage;
}

